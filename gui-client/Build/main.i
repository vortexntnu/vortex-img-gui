void Demo_MultipleAxes() {
    do { ImGui::DemoMarker("implot_demo.cpp", 1583, "Axes/Multiple Axes"); } while (0);
    static float xs[1001], xs2[1001], ys1[1001], ys2[1001], ys3[1001];
    for (int i = 0; i < 1001; ++i) {
