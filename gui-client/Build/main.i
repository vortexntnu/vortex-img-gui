 * \since This function is available since SDL 3.2.0.
 *
 * \sa SDL_GetAudioStreamFrequencyRatio
 * \sa SDL_SetAudioStreamFormat
 */
extern  bool __cdecl SDL_SetAudioStreamFrequencyRatio(SDL_AudioStream *stream, float ratio);

