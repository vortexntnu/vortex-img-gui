    io.AddKeyEvent(ImGuiMod_Ctrl, (sdl_key_mods & (0x0040u | 0x0080u)) != 0);
    io.AddKeyEvent(ImGuiMod_Shift, (sdl_key_mods & (0x0001u | 0x0002u)) != 0);
    io.AddKeyEvent(ImGuiMod_Alt, (sdl_key_mods & (0x0100u | 0x0200u)) != 0);
    io.AddKeyEvent(ImGuiMod_Super, (sdl_key_mods & (0x0400u | 0x0800u)) != 0);
}

