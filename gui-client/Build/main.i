 * \since This function is available since SDL 3.2.0.
 *
 * \sa SDL_SetAudioStreamGain
 */
extern  float __cdecl SDL_GetAudioStreamGain(SDL_AudioStream *stream);

/**
 * Change the gain of an audio stream.
