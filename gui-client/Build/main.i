    ((void)( (!!(g.NavWindowingTarget != 0)) || (_wassert(L"g.NavWindowingTarget != 0", L"C:\\VORTEX_gui_LUKAS\\vortex-img-gui\\extern\\imgui\\imgui.cpp", (unsigned)(14995)), 0)) );

    if (g.NavWindowingTimer < NAV_WINDOWING_LIST_APPEAR_DELAY)
