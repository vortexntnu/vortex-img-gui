    ((void)( (!!(!window->DC.MenuBarAppending)) || (_wassert(L"!window->DC.MenuBarAppending", L"C:\\VORTEX_gui_LUKAS\\vortex-img-gui\\extern\\imgui\\imgui_widgets.cpp", (unsigned)(9315)), 0)) );
