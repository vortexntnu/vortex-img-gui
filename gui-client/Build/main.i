    ((void)( (!!(columns_count > 0 && columns_count < 512)) || (_wassert(L"columns_count > 0 && columns_count < 512", L"C:\\VORTEX_gui_LUKAS\\vortex-img-gui\\extern\\imgui\\imgui_tables.cpp", (unsigned)(329)), 0)) );
    if (flags & ImGuiTableFlags_ScrollX)
