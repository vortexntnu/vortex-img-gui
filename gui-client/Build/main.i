 * \sa SDL_SetAudioStreamFrequencyRatio
 */
extern  bool __cdecl SDL_SetAudioStreamFormat(SDL_AudioStream *stream, const SDL_AudioSpec *src_spec, const SDL_AudioSpec *dst_spec);

