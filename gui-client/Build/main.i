        Build();
    }
}

bool ImGuiTextFilter::Draw(const char* label, float width)
{
    if (width != 0.0f)
        ImGui::SetNextItemWidth(width);
    bool value_changed = ImGui::InputText(label, InputBuf, ((int)(sizeof(InputBuf) / sizeof(*(InputBuf)))));
    if (value_changed)
        Build();
    return value_changed;
