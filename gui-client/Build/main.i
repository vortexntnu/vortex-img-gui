    else if (unit == ImPlotTimeUnit_Mo) {
        constexpr int step[] = {6,3,2,1};
        constexpr int divs[] = {2,4,6,12};
        return LowerBoundStep(max_divs, divs, step, 4);
    }
    return 0;
}

